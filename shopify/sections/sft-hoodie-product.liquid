{% comment %}SFT Apparel — Hoodie Product Section{% endcomment %}
{%- liquid
  assign colour_option = nil
  assign size_option = nil
  assign colour_position = 1
  assign size_position = 2
  for opt in product.options_with_values
    if opt.name == 'Colour' or opt.name == 'Color' or opt.name == 'colour' or opt.name == 'color'
      assign colour_option = opt
      assign colour_position = forloop.index
    endif
    if opt.name == 'Size' or opt.name == 'size'
      assign size_option = opt
      assign size_position = forloop.index
    endif
  endfor
  assign current_variant = product.selected_or_first_available_variant
  assign colour_pos_0 = colour_position | minus: 1
  assign size_pos_0 = size_position | minus: 1
  assign opt_colour_key = 'option' | append: colour_position
  assign current_colour = current_variant[opt_colour_key]
  if current_colour == blank and colour_option
    assign current_colour = colour_option.values | first
  endif
  if current_colour == blank
    assign title_parts = product.title | split: ' - '
    assign current_colour = title_parts | last | strip
  endif

  # Build swatch list
  assign colour_coll = nil
  if section.settings.colour_collection != blank
    assign colour_coll = collections[section.settings.colour_collection]
  endif
  assign sw_names = ''
  assign sw_urls = ''
  assign sw_active = ''
  assign sw_imgs = ''
  assign img_swatches = false
  if colour_coll
    assign img_swatches = true
    for p in colour_coll.products
      assign cname = ''
      for o in p.options_with_values
        if o.name == 'Colour' or o.name == 'Color' or o.name == 'colour' or o.name == 'color'
          assign cname = o.values | first
        endif
      endfor
      if cname == ''
        assign cname = p.metafields.custom.colour
      endif
      if cname == blank
        assign title_parts = p.title | split: ' - '
        assign cname = title_parts | last | strip
      endif
      assign p_img = ''
      if p.featured_media
        assign p_img = p.featured_media | image_url: width: 300
      endif
      assign sw_names = sw_names | append: cname | append: '~~'
      assign sw_urls = sw_urls | append: p.url | append: '~~'
      assign sw_imgs = sw_imgs | append: p_img | append: '~~'
      if p.id == product.id
        assign sw_active = sw_active | append: '1~~'
      else
        assign sw_active = sw_active | append: '0~~'
      endif
    endfor
  elsif colour_option
    for v in colour_option.values
      assign v_img = ''
      for var in product.variants
        if var[opt_colour_key] == v and var.featured_media and v_img == ''
          assign v_img = var.featured_media | image_url: width: 300
        endif
      endfor
      if v_img != ''
        assign img_swatches = true
      endif
      assign sw_names = sw_names | append: v | append: '~~'
      assign sw_urls = sw_urls | append: '#~~'
      assign sw_imgs = sw_imgs | append: v_img | append: '~~'
      if v == current_colour
        assign sw_active = sw_active | append: '1~~'
      else
        assign sw_active = sw_active | append: '0~~'
      endif
    endfor
  endif
  assign names_a = sw_names | split: '~~'
  assign urls_a = sw_urls | split: '~~'
  assign act_a = sw_active | split: '~~'
  assign imgs_a = sw_imgs | split: '~~'
  if img_swatches
    for nm in names_a
      assign chk_img = imgs_a[forloop.index0]
      if chk_img == blank
        assign img_swatches = false
        break
      endif
    endfor
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@200;300;400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet"/>

<style>
.sft-section {
  --ink: #0a0a0a;
  --forest: #2A3B27;
  --cream: #F6F4F0;
  --moss: #A8BE98;
  --moss-dk: #6B7D5E;
  --text: #1a1a1a;
  --text-b: #2a2a2a;
  --text-m: #707070;
  --line: #e6e3de;
  --line-d: #f0efed;
  --amber: #B07D3A;
  --gold: #C9A227;
  --red: #7A3030;
  --ease: cubic-bezier(0.22,1,0.36,1);
  --spring: cubic-bezier(0.34,1.56,0.64,1);
  font-family: 'Jost', Helvetica, Arial, sans-serif;
  color: var(--text);
  background: #fff;
}
.sft-section *, .sft-panel *, .sft-overlay * { box-sizing: border-box; margin: 0; padding: 0; }

/* ===== MOBILE TOP — title/price/stars above image ===== */
.sft-mob-top {
  display: none;
  padding: 18px 18px 14px;
  background: #fff;
  border-bottom: 1px solid var(--line);
}
.sft-mob-top__eyebrow {
  font-size: 9px; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase;
  color: var(--moss-dk); margin-bottom: 8px;
}
.sft-mob-top__title {
  font-family: 'Raleway', sans-serif; font-size: 22px; font-weight: 300;
  line-height: 1.1; color: var(--ink); margin-bottom: 10px;
}
.sft-mob-top__meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
.sft-mob-top__price { font-size: 15px; font-weight: 300; color: var(--text-b); }
.sft-mob-top__stars { color: var(--gold); font-size: 13px; letter-spacing: 1.5px; }
.sft-mob-top__ct { font-size: 11px; font-weight: 300; color: var(--text-m); margin-left: 4px; }
@media (max-width: 860px) {
  .sft-mob-top { display: block; padding-top: {{ section.settings.header_offset | default: 72 }}px; }
}

/* ===== MAIN 2-COL LAYOUT ===== */
.sft-layout {
  display: grid;
  grid-template-columns: 1fr 400px;
  align-items: start;
  background: #fff;
}
@media (max-width: 1100px) { .sft-layout { grid-template-columns: 1fr 360px; } }
@media (max-width: 860px)  { .sft-layout { display: block; } }

/* ===== GALLERY COLUMN (left) ===== */
.sft-gallery-col { }

/* Mobile carousel */
.sft-carousel { display: none; position: relative; }
.sft-car__main {
  aspect-ratio: 3/4; overflow: hidden; background: #f4f4f2;
  user-select: none;
}
.sft-car__main img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity 0.28s ease; pointer-events: none; }
.sft-car__main img.fading { opacity: 0; }

/* Progress pill */
.sft-progress { display: flex; justify-content: center; padding: 13px 0 6px; background: #fff; }
.sft-progress__track {
  position: relative; width: 100px; height: 2px;
  background: rgba(0,0,0,0.12); border-radius: 1px; overflow: hidden;
}
.sft-progress__fill {
  position: absolute; top: 0; height: 100%;
  background: var(--ink); border-radius: 1px;
  transition: left 0.3s var(--ease);
}

@media (max-width: 860px) { .sft-carousel { display: block; } }

/* Desktop mosaic gallery */
.sft-mosaic { display: none; grid-template-columns: 1fr 1fr; gap: 3px; }
.sft-mi { overflow: hidden; background: #f4f4f2; }
.sft-mi.full { grid-column: 1 / -1; }
.sft-mi img { width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block; transition: transform 0.6s var(--ease); }
.sft-mi:hover img { transform: scale(1.02); }
@media (min-width: 861px) { .sft-mosaic { display: grid; } }

/* ===== DETAILS COLUMN (right, sticky on desktop) ===== */
.sft-details-col {
  position: sticky; top: {{ section.settings.header_offset | default: 72 }}px;
  padding: 32px 44px 80px;
  overflow-y: auto;
  max-height: calc(100vh - {{ section.settings.header_offset | default: 72 }}px);
  background: #fff;
  scrollbar-width: none;
}
.sft-details-col::-webkit-scrollbar { display: none; }
@media (max-width: 860px) {
  .sft-details-col { position: static; padding: 22px 18px 64px; max-height: none; overflow-y: visible; }
}

/* Desktop-only header block */
.sft-desk-hd { margin-bottom: 6px; }
@media (max-width: 860px) { .sft-desk-hd { display: none; } }

.sft-eyebrow {
  font-size: 9px; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase;
  color: var(--moss-dk); margin-bottom: 10px;
}
.sft-title {
  font-family: 'Raleway', sans-serif; font-size: 34px; font-weight: 300;
  line-height: 1.06; letter-spacing: -0.01em; color: var(--ink); margin-bottom: 8px;
}
.sft-price { font-size: 15px; font-weight: 300; color: var(--text-b); margin-bottom: 10px; letter-spacing: 0.02em; }
.sft-rating { display: flex; align-items: center; gap: 7px; margin-bottom: 20px; }
.sft-stars { color: var(--gold); font-size: 13px; letter-spacing: 1.5px; }
.sft-rating-ct { font-size: 11px; font-weight: 300; color: var(--text-m); }
.sft-rule { width: 32px; height: 1px; background: var(--ink); opacity: 0.15; margin-bottom: 24px; }

/* Row headings (Size / Colour) */
.sft-row-hd { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12px; }
.sft-row-hd--col { margin-top: 28px; }
.sft-row-lbl { font-size: 10px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-b); }
.sft-link { font-size: 10px; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-m); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; background: none; border: none; font-family: inherit; }
.sft-link:hover { color: var(--ink); }
.sft-returns-note { text-align: center; font-size: 10px; font-weight: 400; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-m); margin: 6px 0 2px; }

/* SELECT SIZE button */
.sft-sz-btn {
  width: 100%; padding: 17px 22px; background: #000; color: #fff;
  font-family: 'Jost', sans-serif; font-size: 11px; font-weight: 500;
  letter-spacing: 0.22em; text-transform: uppercase; border-radius: 2px; border: none;
  display: flex; align-items: center; justify-content: space-between;
  cursor: pointer; transition: background 0.18s, transform 0.12s; margin-bottom: 12px;
}
.sft-sz-btn:hover { background: #222; }
.sft-sz-btn:active { transform: scale(0.99); }
.sft-sz-btn__l { display: flex; align-items: center; gap: 10px; }
.sft-sz-btn__l svg { width: 15px; height: 15px; stroke: rgba(255,255,255,0.65); fill: none; stroke-width: 1.5; stroke-linecap: round; }
.sft-sz-btn__r svg { width: 12px; height: 12px; stroke: rgba(255,255,255,0.65); fill: none; stroke-width: 2; stroke-linecap: round; }

/* Image swatches */
.sft-pick-val { font-size: 11px; font-weight: 400; color: var(--text); text-transform: none; letter-spacing: 0.02em; }
.sft-iswatches { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
.sft-iswatch { flex: 0 0 auto; width: 76px; cursor: pointer; text-decoration: none; background: none; border: none; padding: 0; font-family: inherit; }
.sft-iswatch__imgwrap { position: relative; display: block; }
.sft-iswatch__img { width: 76px; height: 92px; object-fit: cover; background: #f4f4f2; border: 1.5px solid var(--line); transition: border-color 0.2s; display: block; }
.sft-iswatch:hover .sft-iswatch__img { border-color: var(--text-m); }
.sft-iswatch.active .sft-iswatch__img { border-color: var(--ink); }
.sft-iswatch__check { position: absolute; top: 6px; right: 6px; width: 18px; height: 18px; border-radius: 50%; background: var(--ink); display: none; align-items: center; justify-content: center; }
.sft-iswatch.active .sft-iswatch__check { display: flex; }
.sft-iswatch__check svg { width: 9px; height: 9px; stroke: #fff; stroke-width: 2.6; fill: none; stroke-linecap: round; stroke-linejoin: round; }
.sft-iswatch__nm { display: block; text-align: center; margin-top: 6px; font-size: 8px; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-m); }
.sft-iswatch.active .sft-iswatch__nm { color: var(--ink); font-weight: 500; }

/* Colour circle swatches */
.sft-swatches { display: flex; gap: 10px; flex-wrap: wrap; }
.sft-swatch {
  width: 28px; height: 28px; border-radius: 50%; cursor: pointer; display: block;
  border: 2px solid transparent; position: relative; padding: 0;
  transition: transform 0.2s var(--spring); box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06);
}
.sft-swatch::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1.5px solid transparent; transition: border-color 0.2s; }
.sft-swatch.active::after { border-color: var(--ink); }
.sft-swatch:hover { transform: scale(1.1); }

/* Tabs */
.sft-tabs { margin-top: 32px; border-top: 1px solid var(--line); }
.sft-tabs__nav { display: flex; }
.sft-tab {
  flex: 1; padding: 14px 4px; background: none; border: none; border-bottom: 1.5px solid transparent;
  cursor: pointer; font-family: 'Jost', sans-serif; font-size: 9px; font-weight: 500;
  letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-m);
  transition: color 0.18s, border-color 0.18s;
}
.sft-tab.active { color: var(--ink); border-bottom-color: var(--ink); }
.sft-tab:hover { color: var(--ink); }
.sft-tabpanel { display: none; padding: 20px 0 0; font-size: 13px; font-weight: 300; line-height: 1.88; color: var(--text-m); }
.sft-tabpanel.active { display: block; }
.sft-tabpanel ul { padding-left: 16px; }
.sft-tabpanel li { margin-bottom: 5px; }

/* ===== SIZE PANEL ===== */
.sft-overlay {
  position: fixed; inset: 0; background: rgba(10,10,10,0.36);
  opacity: 0; visibility: hidden; z-index: 99998;
  transition: opacity 0.38s var(--ease), visibility 0.38s;
  -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
}
.sft-overlay.open { opacity: 1; visibility: visible; }
.sft-panel {
  position: fixed; top: 0; right: 0; height: 100%; width: 460px; max-width: 94vw;
  background: #fff; transform: translateX(100%); transition: transform 0.48s var(--ease);
  z-index: 99999; display: flex; flex-direction: column;
  font-family: 'Jost', sans-serif; color: var(--text);
  box-shadow: -20px 0 80px rgba(0,0,0,0.12);
}
.sft-panel.open { transform: translateX(0); }

/* Panel header */
.sft-panel__top {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 26px; border-bottom: 1px solid var(--line); flex-shrink: 0;
}
.sft-panel__title { font-family: 'Raleway', sans-serif; font-size: 18px; font-weight: 300; color: var(--ink); }
.sft-panel__close {
  background: none; border: none; cursor: pointer; padding: 0;
  display: flex; align-items: center; gap: 7px;
  font-family: 'Jost', sans-serif; font-size: 9px; font-weight: 500;
  letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-m);
  transition: color 0.18s;
}
.sft-panel__close:hover { color: var(--ink); }
.sft-panel__close svg { width: 16px; height: 16px; stroke: var(--ink); fill: none; stroke-width: 2; stroke-linecap: round; flex-shrink: 0; }

/* Panel product info */
.sft-panel__prod { display: flex; align-items: center; gap: 14px; padding: 16px 26px; border-bottom: 1px solid var(--line); flex-shrink: 0; }
.sft-panel__thumb { width: 54px; height: 68px; object-fit: cover; background: #f4f4f2; flex-shrink: 0; display: block; }
.sft-panel__thumb-ph { width: 54px; height: 68px; background: #f4f4f2; flex-shrink: 0; }
.sft-panel__pt { font-family: 'Raleway', sans-serif; font-size: 17px; font-weight: 300; line-height: 1.2; margin-bottom: 3px; color: var(--ink); }
.sft-panel__pp { font-size: 13px; font-weight: 300; color: var(--text-m); }

/* Panel subheader */
.sft-panel__hd { display: flex; align-items: center; justify-content: space-between; padding: 13px 26px; border-bottom: 1px solid var(--line); flex-shrink: 0; }
.sft-panel__hl { font-size: 9px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-m); }
.sft-panel__hg { font-size: 9px; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-m); background: none; border: none; cursor: pointer; font-family: inherit; text-decoration: underline; text-underline-offset: 3px; display: flex; align-items: center; gap: 4px; }
.sft-panel__hg svg { width: 11px; height: 11px; stroke: var(--text-m); fill: none; stroke-width: 1.8; }

/* Size rows */
.sft-panel__list { flex: 1; overflow-y: auto; }
.sft-prow {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 26px; border-bottom: 1px solid var(--line-d);
  cursor: pointer; transition: background 0.14s; position: relative; background: #fff;
}
.sft-prow:hover:not(.disabled):not(.adding) { background: #f8f8f8; }
.sft-prow.disabled { cursor: default; }
.sft-prow.adding { background: #f8f8f8; cursor: default; }
.sft-prow__nm { font-size: 13px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text); }
.sft-prow.disabled .sft-prow__nm { color: #c0bcb7; }
.sft-prow__st { font-size: 9px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; }
.sft-prow__st.in { color: var(--moss-dk); }
.sft-prow__st.low { color: var(--amber); }
.sft-prow__st.notify { color: var(--text-m); text-decoration: underline; text-underline-offset: 3px; }
.sft-prow__st.adding-st { color: var(--text-m); }

/* Notify Me */
.sft-notify-wrap { overflow: hidden; max-height: 0; opacity: 0; transition: max-height 0.3s var(--ease), opacity 0.22s; background: #f8f8f8; }
.sft-notify-wrap.open { max-height: 110px; opacity: 1; }
.sft-notify-inner { padding: 14px 26px 18px; }
.sft-notify-cap { font-size: 11px; font-weight: 300; color: var(--text-m); margin-bottom: 9px; }
.sft-notify-row { display: flex; gap: 6px; }
.sft-notify-input { flex: 1; padding: 10px 14px; font-family: inherit; font-size: 12px; font-weight: 300; color: var(--text); background: #fff; border: 1px solid var(--line); border-radius: 2px; outline: none; }
.sft-notify-input:focus { border-color: var(--ink); }
.sft-notify-sub { padding: 10px 16px; font-family: inherit; font-size: 9px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; background: var(--ink); color: #fff; border-radius: 2px; border: none; cursor: pointer; white-space: nowrap; }
.sft-notify-sub:hover { background: #333; }
.sft-notify-sub.sent { background: #e8f4e8; color: var(--forest); }

/* ===== BELOW-FOLD SECTIONS ===== */
.sft-feat { background: var(--ink); color: #edeae3; }
.sft-feat__in { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(3,1fr); }
.sft-feat__col { padding: 48px 52px; border-left: 1px solid rgba(255,255,255,0.08); }
.sft-feat__col:first-child { border-left: none; }
.sft-feat__t { font-family: 'Raleway', sans-serif; font-size: 28px; font-weight: 300; color: #fff; margin-bottom: 12px; }
.sft-feat__x { font-size: 14px; font-weight: 300; line-height: 1.65; color: #9a9690; }

.sft-ed { background: #fff; padding: 96px 24px; border-top: 1px solid var(--line); }
.sft-ed__in { max-width: 1280px; margin: 0 auto; }
.sft-ed__h { font-family: 'Raleway', sans-serif; font-size: 52px; font-weight: 300; line-height: 1.04; letter-spacing: -0.02em; color: var(--ink); margin-bottom: 20px; }
.sft-ed__b { font-size: 15px; font-weight: 300; line-height: 1.75; color: var(--text-m); max-width: 600px; margin-bottom: 56px; }
.sft-cards { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
.sft-card { background: #fff; padding: 32px 28px; }
.sft-card__t { font-family: 'Raleway', sans-serif; font-size: 21px; font-weight: 300; color: var(--ink); margin-bottom: 10px; }
.sft-card__x { font-size: 13px; font-weight: 300; line-height: 1.75; color: var(--text-m); }

.sft-rev { background: var(--ink); padding: 92px 24px; }
.sft-rev__in { max-width: 1280px; margin: 0 auto; }
.sft-rev__h { font-family: 'Raleway', sans-serif; font-size: 46px; font-weight: 300; color: #fff; margin-bottom: 44px; letter-spacing: -0.01em; }
.sft-rev__widget { }
.sft-rev .klaviyo-product-reviews { color: #fff; }

.sft-cta { background: #fff; padding: 108px 24px; text-align: center; border-top: 1px solid var(--line); }
.sft-cta__h { font-family: 'Raleway', sans-serif; font-size: 54px; font-weight: 300; letter-spacing: -0.02em; color: var(--ink); margin-bottom: 16px; }
.sft-cta__x { font-size: 15px; font-weight: 300; color: var(--text-m); margin-bottom: 38px; }
.sft-cta__btn { display: inline-block; padding: 18px 56px; background: var(--ink); color: #fff; font-family: 'Jost', sans-serif; font-size: 11px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; border: none; border-radius: 2px; cursor: pointer; transition: background 0.18s, transform 0.12s; }
.sft-cta__btn:hover { background: #333; }
.sft-cta__btn:active { transform: scale(0.99); }

/* Toast */
.sft-toast { position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%) translateY(20px); opacity: 0; background: var(--ink); color: #fff; font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; padding: 13px 24px; border-radius: 2px; z-index: 999999; pointer-events: none; transition: transform 0.4s var(--spring), opacity 0.28s; white-space: nowrap; }
.sft-toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

/* ===== RESPONSIVE ===== */
@media (max-width: 980px) {
  .sft-cards { grid-template-columns: repeat(2,1fr); }
  .sft-feat__in { grid-template-columns: 1fr; }
  .sft-feat__col { border-left: none; border-top: 1px solid rgba(255,255,255,0.08); }
  .sft-feat__col:first-child { border-top: none; }
}
@media (max-width: 860px) {
  .sft-ed { padding: 60px 18px; }
  .sft-ed__h { font-size: 36px; }
  .sft-rev { padding: 60px 18px; }
  .sft-rev__h { font-size: 32px; }
  .sft-cta { padding: 72px 18px; }
  .sft-cta__h { font-size: 36px; }
  .sft-ed__b { margin-bottom: 36px; }
}
@media (max-width: 560px) {
  .sft-cards { grid-template-columns: 1fr; }
}
</style>

<div class="sft-section">

  <!-- ===== MOBILE ONLY: title / price / stars above image ===== -->
  <div class="sft-mob-top">
    <div class="sft-mob-top__eyebrow">{{ section.settings.eyebrow | default: shop.name }}</div>
    <div class="sft-mob-top__title">{{ product.title }}</div>
    <div class="sft-mob-top__meta">
      <span class="sft-mob-top__price" id="sft-price-mob">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span style="color:var(--red);margin-right:6px;">{{ current_variant.price | money }}</span>
          <span style="text-decoration:line-through;opacity:0.4;">{{ current_variant.compare_at_price | money }}</span>
        {%- else -%}
          {{ current_variant.price | money }}
        {%- endif -%}
        {{ shop.currency }}
      </span>
      {%- if section.settings.show_rating -%}
      <div>
        <span class="sft-mob-top__stars">★★★★★</span>
        <span class="sft-mob-top__ct">{{ section.settings.rating_count | default: '43 reviews' }}</span>
      </div>
      {%- endif -%}
    </div>
  </div>

  <!-- ===== MAIN LAYOUT: gallery left + details right ===== -->
  <div class="sft-layout">

    <!-- GALLERY COLUMN -->
    <div class="sft-gallery-col">

      <!-- Mobile carousel (hidden on desktop) -->
      <div class="sft-carousel">
        <div class="sft-car__main" id="sft-car-main">
          {%- if current_variant.featured_media -%}
            <img id="sft-main-img" src="{{ current_variant.featured_media | image_url: width: 900 }}" alt="{{ current_variant.featured_media.alt | escape | default: product.title | escape }}" loading="eager"/>
          {%- elsif product.featured_media -%}
            <img id="sft-main-img" src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="eager"/>
          {%- else -%}
            <img id="sft-main-img" src="{{ 'product-1' | placeholder_svg_tag }}" alt="{{ product.title | escape }}"/>
          {%- endif -%}
        </div>
        <div class="sft-progress">
          <div class="sft-progress__track">
            <div class="sft-progress__fill" id="sft-pfill"></div>
          </div>
        </div>
      </div>

      <!-- Desktop mosaic (hidden on mobile) — pattern: full, half, half, full, half, half... -->
      <div class="sft-mosaic">
        {%- for media in product.media -%}
          {%- assign pat = forloop.index0 | modulo: 3 -%}
          <div class="sft-mi{% if pat == 0 %} full{% else %} half{% endif %}">
            <img src="{{ media | image_url: width: 960 }}" alt="{{ media.alt | escape | default: product.title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"/>
          </div>
        {%- endfor -%}
      </div>

    </div><!-- end gallery col -->

    <!-- DETAILS COLUMN (sticky on desktop) -->
    <div class="sft-details-col">

      <!-- Desktop-only: eyebrow / title / price / rating / rule -->
      <div class="sft-desk-hd">
        <div class="sft-eyebrow">{{ section.settings.eyebrow | default: shop.name }}</div>
        <h1 class="sft-title">{{ product.title }}</h1>
        <div class="sft-price" id="sft-price">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span style="color:var(--red);margin-right:6px;">{{ current_variant.price | money }}</span>
            <span style="text-decoration:line-through;opacity:0.4;">{{ current_variant.compare_at_price | money }}</span>
          {%- else -%}
            {{ current_variant.price | money }}
          {%- endif -%}
          {{ shop.currency }}
        </div>
        {%- if section.settings.show_rating -%}
        <div class="sft-rating">
          <span class="sft-stars">★★★★★</span>
          <span class="sft-rating-ct">{{ section.settings.rating_count | default: '43 reviews' }}</span>
        </div>
        {%- endif -%}
        <div class="sft-rule"></div>
      </div>

      <!-- SIZE -->
      <div class="sft-row-hd">
        <span class="sft-row-lbl">Size</span>
        <button class="sft-link" id="sft-guide-open">Size guide</button>
      </div>
      <button class="sft-sz-btn" id="sft-sz-btn" aria-haspopup="dialog">
        <span class="sft-sz-btn__l">
          <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h8m-8 6h16"/></svg>
          <span id="sft-sz-lbl">Select Size</span>
        </span>
        <span class="sft-sz-btn__r">
          <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
        </span>
      </button>
      <div class="sft-returns-note">{{ section.settings.returns_note | default: 'Free 30-day returns and exchanges' }}</div>

      <!-- COLOUR SWATCHES -->
      {%- if names_a.size > 0 -%}
      <div class="sft-row-hd sft-row-hd--col">
        <span class="sft-row-lbl">{%- if colour_option -%}{{ colour_option.name }}{%- else -%}Colour{%- endif -%}</span>
        <span class="sft-pick-val" id="sft-col-lbl">{{ current_colour }}</span>
      </div>

      {%- if img_swatches -%}
      <div class="sft-iswatches" id="sft-swatches">
        {%- for nm in names_a -%}
          {%- assign sw_url = urls_a[forloop.index0] -%}
          {%- assign sw_is_active = act_a[forloop.index0] -%}
          {%- assign sw_img = imgs_a[forloop.index0] -%}
          {%- if sw_url == '#' -%}
            <button class="sft-iswatch{% if sw_is_active == '1' %} active{% endif %}" data-colour="{{ nm | escape }}" aria-label="{{ nm | escape }}">
              <span class="sft-iswatch__imgwrap"><img class="sft-iswatch__img" src="{{ sw_img }}" alt="{{ nm | escape }}" loading="lazy"/><span class="sft-iswatch__check"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
              <span class="sft-iswatch__nm">{{ nm }}</span>
            </button>
          {%- else -%}
            <a class="sft-iswatch{% if sw_is_active == '1' %} active{% endif %}" href="{{ sw_url }}" aria-label="{{ nm | escape }}">
              <span class="sft-iswatch__imgwrap"><img class="sft-iswatch__img" src="{{ sw_img }}" alt="{{ nm | escape }}" loading="lazy"/><span class="sft-iswatch__check"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
              <span class="sft-iswatch__nm">{{ nm }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- else -%}
      <div class="sft-swatches" id="sft-swatches">
        {%- for nm in names_a -%}
          {%- assign sw_url = urls_a[forloop.index0] -%}
          {%- assign sw_is_active = act_a[forloop.index0] -%}
          {%- assign c_handle = nm | downcase | strip -%}
          {%- case c_handle -%}
            {%- when 'moss' -%}{%- assign sw_bg = '#6B7D5E' -%}
            {%- when 'oat' -%}{%- assign sw_bg = '#D9C9B0' -%}
            {%- when 'charcoal' -%}{%- assign sw_bg = '#3A3A3A' -%}
            {%- when 'black' -%}{%- assign sw_bg = '#1A1A1A' -%}
            {%- when 'white' -%}{%- assign sw_bg = '#F0EEE8' -%}
            {%- when 'cream','natural','ecru' -%}{%- assign sw_bg = '#EFE8DA' -%}
            {%- when 'mocha' -%}{%- assign sw_bg = '#6F4E37' -%}
            {%- when 'navy' -%}{%- assign sw_bg = '#1B2A4A' -%}
            {%- when 'grey','gray' -%}{%- assign sw_bg = '#8A8A8A' -%}
            {%- when 'sand','taupe' -%}{%- assign sw_bg = '#C2A882' -%}
            {%- when 'sage' -%}{%- assign sw_bg = '#8FA886' -%}
            {%- when 'forest','green' -%}{%- assign sw_bg = '#2A3B27' -%}
            {%- when 'camel' -%}{%- assign sw_bg = '#C19A6B' -%}
            {%- when 'blush','pink' -%}{%- assign sw_bg = '#E8BFCA' -%}
            {%- when 'sky','sky blue' -%}{%- assign sw_bg = '#7EB8D4' -%}
            {%- when 'lavender' -%}{%- assign sw_bg = '#B5A0D4' -%}
            {%- when 'rust' -%}{%- assign sw_bg = '#B45309' -%}
            {%- when 'stone' -%}{%- assign sw_bg = '#9B8F82' -%}
            {%- when 'olive' -%}{%- assign sw_bg = '#6B7C3A' -%}
            {%- when 'burgundy','wine' -%}{%- assign sw_bg = '#7C2535' -%}
            {%- when 'teal' -%}{%- assign sw_bg = '#2A8080' -%}
            {%- when 'cobalt','blue' -%}{%- assign sw_bg = '#3A5A8A' -%}
            {%- when 'slate' -%}{%- assign sw_bg = '#586068' -%}
            {%- else -%}{%- assign sw_bg = '#888888' -%}
          {%- endcase -%}
          {%- if sw_url == '#' -%}
            <button class="sft-swatch{% if sw_is_active == '1' %} active{% endif %}" data-colour="{{ nm | escape }}" style="background:{{ sw_bg }};" aria-label="{{ nm | escape }}" title="{{ nm | escape }}"></button>
          {%- else -%}
            <a class="sft-swatch{% if sw_is_active == '1' %} active{% endif %}" href="{{ sw_url }}" style="background:{{ sw_bg }};" aria-label="{{ nm | escape }}" title="{{ nm | escape }}"></a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- endif -%}

      <!-- TABS -->
      <div class="sft-tabs">
        <div class="sft-tabs__nav" role="tablist">
          <button class="sft-tab active" data-tab="desc" role="tab">Details</button>
          <button class="sft-tab" data-tab="fabric" role="tab">Fabric &amp; Care</button>
          <button class="sft-tab" data-tab="ship" role="tab">Shipping</button>
        </div>
        <div class="sft-tabs__panels">
          <div class="sft-tabpanel active" data-panel="desc">{{ product.description }}</div>
          <div class="sft-tabpanel" data-panel="fabric">
            {%- if product.metafields.custom.fabric_care != blank -%}
              {{ product.metafields.custom.fabric_care }}
            {%- else -%}
              <ul><li>460gsm brushed fleece, soft warm interior</li><li>80% ring-spun cotton, 20% recycled polyester</li><li>Garment dyed after construction</li><li>Cold machine wash inside out</li><li>Tumble dry low or lay flat</li></ul>
            {%- endif -%}
          </div>
          <div class="sft-tabpanel" data-panel="ship">
            <ul><li>Free standard shipping on orders over $150 AUD</li><li>Express (1–3 business days): $12</li><li>Standard (3–7 business days): $8</li><li>International from $18 AUD</li><li>Returns within 30 days — unworn, tags attached</li></ul>
          </div>
        </div>
      </div>

    </div><!-- end details col -->
  </div><!-- end layout -->

  <!-- ===== FEATURE BAR ===== -->
  {%- if section.settings.show_feature_bar -%}
  <div class="sft-feat">
    <div class="sft-feat__in">
      <div class="sft-feat__col"><h3 class="sft-feat__t">{{ section.settings.feature_1_title }}</h3><p class="sft-feat__x">{{ section.settings.feature_1_text }}</p></div>
      <div class="sft-feat__col"><h3 class="sft-feat__t">{{ section.settings.feature_2_title }}</h3><p class="sft-feat__x">{{ section.settings.feature_2_text }}</p></div>
      <div class="sft-feat__col"><h3 class="sft-feat__t">{{ section.settings.feature_3_title }}</h3><p class="sft-feat__x">{{ section.settings.feature_3_text }}</p></div>
    </div>
  </div>
  {%- endif -%}

  <!-- ===== EDITORIAL ===== -->
  {%- if section.settings.show_editorial -%}
  <div class="sft-ed">
    <div class="sft-ed__in">
      <h2 class="sft-ed__h">{{ section.settings.editorial_heading }}</h2>
      <p class="sft-ed__b">{{ section.settings.editorial_body }}</p>
      <div class="sft-cards">
        <div class="sft-card"><h4 class="sft-card__t">{{ section.settings.card_1_title }}</h4><p class="sft-card__x">{{ section.settings.card_1_text }}</p></div>
        <div class="sft-card"><h4 class="sft-card__t">{{ section.settings.card_2_title }}</h4><p class="sft-card__x">{{ section.settings.card_2_text }}</p></div>
        <div class="sft-card"><h4 class="sft-card__t">{{ section.settings.card_3_title }}</h4><p class="sft-card__x">{{ section.settings.card_3_text }}</p></div>
        <div class="sft-card"><h4 class="sft-card__t">{{ section.settings.card_4_title }}</h4><p class="sft-card__x">{{ section.settings.card_4_text }}</p></div>
      </div>
    </div>
  </div>
  {%- endif -%}

  <!-- ===== REVIEWS — Klaviyo widget ===== -->
  {%- if section.settings.show_reviews -%}
  <div class="sft-rev">
    <div class="sft-rev__in">
      <h2 class="sft-rev__h">{{ section.settings.reviews_heading }}</h2>
      <div class="sft-rev__widget">
        <div class="klaviyo-product-reviews" data-product-id="{{ product.id }}"></div>
      </div>
    </div>
  </div>
  {%- endif -%}

  <!-- ===== FINAL CTA ===== -->
  {%- if section.settings.show_final_cta -%}
  <div class="sft-cta">
    <h2 class="sft-cta__h">{{ section.settings.cta_heading }}</h2>
    <p class="sft-cta__x">{{ section.settings.cta_text }}</p>
    <button class="sft-cta__btn" id="sft-cta-btn">{{ section.settings.cta_button | default: 'Add to Bag' }}{%- if current_variant.price -%} — {{ current_variant.price | money_without_trailing_zeros }}{%- endif -%}</button>
  </div>
  {%- endif -%}

</div><!-- end sft-section -->

<!-- ===== SLIDE-OUT SIZE PANEL ===== -->
<div class="sft-overlay" id="sft-overlay"></div>
<aside class="sft-panel" id="sft-panel" role="dialog" aria-modal="true" aria-label="Select size">

  <div class="sft-panel__top">
    <span class="sft-panel__title">Select your size</span>
    <button class="sft-panel__close" id="sft-panel-close" aria-label="Close">
      <svg viewBox="0 0 24 24"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
      <span>Close</span>
    </button>
  </div>

  <div class="sft-panel__prod">
    {%- if current_variant.featured_media -%}
      <img class="sft-panel__thumb" id="sft-panel-thumb" src="{{ current_variant.featured_media | image_url: width: 160 }}" alt="{{ product.title | escape }}"/>
    {%- elsif product.featured_media -%}
      <img class="sft-panel__thumb" id="sft-panel-thumb" src="{{ product.featured_media | image_url: width: 160 }}" alt="{{ product.title | escape }}"/>
    {%- else -%}
      <div class="sft-panel__thumb-ph" id="sft-panel-thumb"></div>
    {%- endif -%}
    <div>
      <div class="sft-panel__pt">{{ product.title }}</div>
      <div class="sft-panel__pp" id="sft-panel-price">{{ current_variant.price | money }} {{ shop.currency }}</div>
    </div>
  </div>

  <div class="sft-panel__hd">
    <span class="sft-panel__hl">Tap a size to add to bag</span>
    <button class="sft-panel__hg" id="sft-guide-open2">Size guide <svg viewBox="0 0 24 24"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></button>
  </div>

  <div class="sft-panel__list" id="sft-sz-list"></div>

</aside>

<!-- Size guide dialog -->
<dialog id="sft-guide" style="padding:32px;border:1px solid #e6e3de;border-radius:2px;font-family:'Jost',Helvetica,Arial,sans-serif;max-width:420px;width:90%;">
  <p style="font-family:'Raleway',sans-serif;font-size:22px;font-weight:300;color:#0a0a0a;margin:0 0 16px;">Size Guide</p>
  <table style="width:100%;border-collapse:collapse;font-size:13px;font-weight:300;color:#707070;">
    <thead><tr>
      <th style="text-align:left;padding:7px 0;border-bottom:1px solid #e6e3de;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;font-weight:500;">Size</th>
      <th style="text-align:left;padding:7px 0;border-bottom:1px solid #e6e3de;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;font-weight:500;">Chest (cm)</th>
      <th style="text-align:left;padding:7px 0;border-bottom:1px solid #e6e3de;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;font-weight:500;">Length (cm)</th>
    </tr></thead>
    <tbody>
      <tr><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">XS</td><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">86–90</td><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">65</td></tr>
      <tr><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">S</td><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">91–96</td><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">67</td></tr>
      <tr><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">M</td><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">97–102</td><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">70</td></tr>
      <tr><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">L</td><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">103–108</td><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">72</td></tr>
      <tr><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">XL</td><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">109–115</td><td style="padding:9px 0;border-bottom:1px solid #e6e3de;">74</td></tr>
      <tr><td style="padding:9px 0;">XXL</td><td style="padding:9px 0;">116–122</td><td style="padding:9px 0;">76</td></tr>
    </tbody>
  </table>
  <button onclick="document.getElementById('sft-guide').close()" style="margin-top:20px;background:#0a0a0a;color:#fff;border:none;padding:11px 24px;border-radius:2px;font-family:inherit;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;cursor:pointer;">Close</button>
</dialog>

<div class="sft-toast" id="sft-toast"></div>

<script>
(function(){
  var LOW = {{ section.settings.low_threshold | default: 5 }};
  var VARIANTS = {{ product.variants | json }};
  var MEDIA = [{% for m in product.media %}{"id":{{ m.id }},"url":"{{ m | image_url: width: 900 }}","alt":{{ m.alt | default: product.title | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}];
  var COL_POS = {{ colour_pos_0 }};
  var SZ_POS  = {{ size_pos_0 }};
  var OPT_COL = 'option' + (COL_POS + 1);
  var OPT_SZ  = 'option' + (SZ_POS + 1);
  var HAS_COLOUR = {% if colour_option %}true{% else %}false{% endif %};
  var SIZE_MASTER = {{ section.settings.size_order | default: 'XS,S,M,L,XL,XXL' | split: ',' | json }}.map(function(s){return s.trim();}).filter(Boolean);
  var CURRENCY = '{{ shop.currency }}';
  var COL_MEDIA = {};
  VARIANTS.forEach(function(v){ var c=v[OPT_COL]; if(c&&!COL_MEDIA[c]&&v.featured_media) COL_MEDIA[c]=v.featured_media.id; });

  var activeCol = {{ current_colour | json }};
  var activeIdx = 0;
  var curImgs = MEDIA.slice();
  var notifyOpen = {};

  function fmtMoney(c){ return '$'+(c/100).toFixed(2); }

  /* Colour swatches */
  document.querySelectorAll('button.sft-swatch, button.sft-iswatch').forEach(function(sw){
    sw.addEventListener('click', function(){ setColour(sw.dataset.colour); });
  });

  function setColour(col){
    activeCol = col;
    document.querySelectorAll('.sft-swatch,.sft-iswatch').forEach(function(s){ s.classList.toggle('active', s.dataset&&s.dataset.colour===col); });
    var lbl=document.getElementById('sft-col-lbl'); if(lbl) lbl.textContent=col;
    buildImgList(col);
    var v=VARIANTS.find(function(x){ return x[OPT_COL]===col; });
    if(v){
      try{ var p=new URLSearchParams(window.location.search); p.set('variant',v.id); history.replaceState(null,'','?'+p); }catch(e){}
      var price=fmtMoney(v.price)+' '+CURRENCY;
      var pe=document.getElementById('sft-price'); if(pe) pe.textContent=price;
      var pm=document.getElementById('sft-price-mob'); if(pm) pm.textContent=price;
      var pp=document.getElementById('sft-panel-price'); if(pp) pp.textContent=price;
      var t=document.getElementById('sft-panel-thumb'); if(t&&t.tagName==='IMG'&&v.featured_media) t.src=v.featured_media.preview_image?v.featured_media.preview_image.src:t.src;
    }
  }

  /* Mobile carousel */
  function buildImgList(col){
    var featId=COL_MEDIA[col];
    curImgs=featId?[].concat(MEDIA.filter(function(m){return m.id===featId;}),MEDIA.filter(function(m){return m.id!==featId;})):MEDIA.slice();
    setIdx(0,true);
  }

  function setIdx(i, instant){
    activeIdx=i;
    var img=document.getElementById('sft-main-img'); if(!img||!curImgs[i]) return;
    if(instant){ img.src=curImgs[i].url; img.alt=curImgs[i].alt||activeCol; updatePill(); return; }
    img.classList.add('fading');
    setTimeout(function(){ img.src=curImgs[i].url; img.alt=curImgs[i].alt||activeCol; img.classList.remove('fading'); updatePill(); }, 220);
  }

  function updatePill(){
    var fill=document.getElementById('sft-pfill'); if(!fill) return;
    var n=curImgs.length; if(!n) return;
    var pct=100/n;
    fill.style.width=pct+'%';
    fill.style.left=(activeIdx*pct)+'%';
  }

  buildImgList(activeCol);

  /* Touch swipe on carousel */
  (function(){
    var el=document.getElementById('sft-car-main'); if(!el) return;
    var sx=0, sy=0, isH=null;
    el.addEventListener('touchstart',function(e){
      sx=e.touches[0].clientX; sy=e.touches[0].clientY; isH=null;
    },{passive:true});
    el.addEventListener('touchmove',function(e){
      if(isH===null){
        var dx=Math.abs(e.touches[0].clientX-sx), dy=Math.abs(e.touches[0].clientY-sy);
        if(dx>6||dy>6) isH=(dx>dy);
      }
      if(isH) e.preventDefault();
    },{passive:false});
    el.addEventListener('touchend',function(e){
      if(!isH) return;
      var dx=e.changedTouches[0].clientX-sx;
      if(Math.abs(dx)<30) return;
      var n=curImgs.length;
      if(dx<0&&activeIdx<n-1) setIdx(activeIdx+1,false);
      else if(dx>0&&activeIdx>0) setIdx(activeIdx-1,false);
    },{passive:true});
  })();

  /* Panel open/close */
  var overlay=document.getElementById('sft-overlay');
  var panel=document.getElementById('sft-panel');

  function openPanel(){ renderSizes(); overlay.classList.add('open'); panel.classList.add('open'); document.body.style.overflow='hidden'; }
  function closePanel(){ overlay.classList.remove('open'); panel.classList.remove('open'); document.body.style.overflow=''; }

  document.getElementById('sft-sz-btn').addEventListener('click', openPanel);
  document.getElementById('sft-panel-close').addEventListener('click', closePanel);
  overlay.addEventListener('click', closePanel);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') closePanel(); });
  var ctaBtn=document.getElementById('sft-cta-btn'); if(ctaBtn) ctaBtn.addEventListener('click', openPanel);

  /* Open cart drawer (works with most Shopify themes) */
  function openCartDrawer(){
    ['cart:refresh','cart:updated','cart:open','theme:cart:open'].forEach(function(evt){
      document.dispatchEvent(new CustomEvent(evt,{bubbles:true,detail:{}}));
    });
    var sels=['[data-cart-toggle]','[data-cart-icon-bubble]','#cart-icon-bubble',
      '.header__icon--cart','[aria-controls="CartDrawer"]','[data-drawer="cart"]',
      '[aria-label="Cart"]','a[href="/cart"].header__icon','.cart-count-bubble'];
    for(var i=0;i<sels.length;i++){
      var el=document.querySelector(sels[i]);
      if(el&&el.offsetParent!==null){ el.click(); return; }
    }
  }

  /* Render sizes in panel */
  function renderSizes(){
    var list=document.getElementById('sft-sz-list'); if(!list) return; list.innerHTML='';
    var map={};
    VARIANTS.forEach(function(v){
      if(HAS_COLOUR&&v[OPT_COL]!==activeCol) return;
      var s=(v[OPT_SZ]||v.title||'').trim(); if(s) map[s]=v;
    });
    var sizes=SIZE_MASTER.slice();
    Object.keys(map).forEach(function(s){ if(!sizes.includes(s)) sizes.push(s); });

    sizes.forEach(function(sz){
      var v=map[sz], exists=!!v, avail=exists&&v.available;
      var managed=exists&&v.inventory_management&&v.inventory_management!=='';
      var qty=exists?v.inventory_quantity:0;
      var isLow=avail&&managed&&qty!==null&&qty<=LOW;
      var canBuy=avail;

      var stCls,stTxt;
      if(!canBuy){ stCls='notify'; stTxt='Notify Me'; }
      else if(isLow){ stCls='low'; stTxt='Low Stock'; }
      else { stCls='in'; stTxt='In Stock'; }

      var key=(activeCol+'-'+sz).replace(/[^a-z0-9]/gi,'_');
      var row=document.createElement('div');
      row.className='sft-prow'+(canBuy?'':' disabled');
      row.innerHTML='<span class="sft-prow__nm">'+sz+'</span><span class="sft-prow__st '+stCls+'" id="st_'+key+'">'+stTxt+'</span>';

      if(canBuy){
        row.addEventListener('click',function(){ if(!row.classList.contains('adding')) addToCart(v,sz,row,key); });
      } else {
        row.addEventListener('click',function(){ toggleNotify(key); });
      }
      list.appendChild(row);

      if(!canBuy){
        var nw=document.createElement('div');
        nw.className='sft-notify-wrap'; nw.id='nw_'+key;
        nw.innerHTML='<div class="sft-notify-inner"><div class="sft-notify-cap">Out of stock — get an email when '+sz+' is back.</div><div class="sft-notify-row"><input class="sft-notify-input" type="email" placeholder="your@email.com" id="ne_'+key+'"/><button class="sft-notify-sub" id="ns_'+key+'">Notify</button></div></div>';
        list.appendChild(nw);
        var sub=nw.querySelector('#ns_'+key);
        sub.addEventListener('click',function(){ submitNotify(key); });
      }
    });
  }

  /* Immediately add to cart when size tapped */
  function addToCart(v,sz,row,key){
    row.classList.add('adding');
    var stEl=document.getElementById('st_'+key);
    if(stEl){ stEl.className='sft-prow__st adding-st'; stEl.textContent='···'; }

    fetch('/cart/add.js',{
      method:'POST',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify({id:v.id,quantity:1})
    })
    .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
    .then(function(res){
      if(!res.ok) throw new Error(res.d.description||'Error');
      var lbl=document.getElementById('sft-sz-lbl'); if(lbl) lbl.textContent=activeCol+' / '+sz;
      toast(activeCol+' / '+sz+' added to bag');
      closePanel();
      setTimeout(openCartDrawer,300);
      document.dispatchEvent(new CustomEvent('cart:updated',{bubbles:true}));
    })
    .catch(function(){
      row.classList.remove('adding');
      if(stEl){ stEl.className='sft-prow__st in'; stEl.textContent='In Stock'; }
      toast('Could not add. Please try again.');
    });
  }

  function toggleNotify(key){
    var nw=document.getElementById('nw_'+key); if(!nw) return;
    notifyOpen[key]=!notifyOpen[key];
    nw.classList.toggle('open',notifyOpen[key]);
    if(notifyOpen[key]){ var inp=document.getElementById('ne_'+key); if(inp) setTimeout(function(){inp.focus();},300); }
  }

  function submitNotify(key){
    var inp=document.getElementById('ne_'+key);
    if(!inp||!inp.value.trim()||inp.value.indexOf('@')<0){ if(inp){inp.style.borderColor='#7A3030'; setTimeout(function(){inp.style.borderColor='';},1200);} return; }
    inp.disabled=true;
    var sub=document.getElementById('ns_'+key); if(sub){sub.textContent='✓ Done'; sub.classList.add('sent');}
    toast("We'll let you know when it's back");
  }

  /* Size guide */
  var guide=document.getElementById('sft-guide');
  ['sft-guide-open','sft-guide-open2'].forEach(function(id){
    var el=document.getElementById(id); if(el) el.addEventListener('click',function(){guide.showModal();});
  });

  /* Tabs */
  document.querySelectorAll('.sft-tab').forEach(function(tab){
    tab.addEventListener('click',function(){
      var key=tab.dataset.tab;
      document.querySelectorAll('.sft-tab').forEach(function(t){t.classList.toggle('active',t===tab);});
      document.querySelectorAll('.sft-tabpanel').forEach(function(p){p.classList.toggle('active',p.dataset.panel===key);});
    });
  });

  function toast(msg){
    var t=document.getElementById('sft-toast'); if(!t) return;
    t.textContent=msg; t.classList.add('show');
    clearTimeout(t._t); t._t=setTimeout(function(){t.classList.remove('show');},2800);
  }
})();
</script>

