{% comment %}SFT Apparel — Hoodie Product Section{% endcomment %}
{%- liquid
  assign colour_option = nil
  assign size_option = nil
  assign colour_position = 1
  assign size_position = 2
  for opt in product.options_with_values
    if opt.name == 'Colour' or opt.name == 'Color' or opt.name == 'colour' or opt.name == 'color'
      assign colour_option = opt
      assign colour_position = forloop.index
    endif
    if opt.name == 'Size' or opt.name == 'size'
      assign size_option = opt
      assign size_position = forloop.index
    endif
  endfor
  assign current_variant = product.selected_or_first_available_variant
  assign colour_pos_0 = colour_position | minus: 1
  assign size_pos_0 = size_position | minus: 1
  assign opt_colour_key = 'option' | append: colour_position
  assign current_colour = current_variant[opt_colour_key]
  if current_colour == blank and colour_option
    assign current_colour = colour_option.values | first
  endif
  if current_colour == blank
    assign title_parts = product.title | split: ' - '
    assign current_colour = title_parts | last | strip
  endif

  # Build the swatch list. If a colour collection is set, link across products.
  assign colour_coll = nil
  if section.settings.colour_collection != blank
    assign colour_coll = collections[section.settings.colour_collection]
  endif
  assign sw_names = ''
  assign sw_urls = ''
  assign sw_active = ''
  assign sw_imgs = ''
  assign img_swatches = false
  if colour_coll
    assign img_swatches = true
    for p in colour_coll.products
      assign cname = ''
      for o in p.options_with_values
        if o.name == 'Colour' or o.name == 'Color' or o.name == 'colour' or o.name == 'color'
          assign cname = o.values | first
        endif
      endfor
      if cname == ''
        assign cname = p.metafields.custom.colour
      endif
      if cname == blank
        assign title_parts = p.title | split: ' - '
        assign cname = title_parts | last | strip
      endif
      assign p_img = ''
      if p.featured_media
        assign p_img = p.featured_media | image_url: width: 300
      endif
      assign sw_names = sw_names | append: cname | append: '~~'
      assign sw_urls = sw_urls | append: p.url | append: '~~'
      assign sw_imgs = sw_imgs | append: p_img | append: '~~'
      if p.id == product.id
        assign sw_active = sw_active | append: '1~~'
      else
        assign sw_active = sw_active | append: '0~~'
      endif
    endfor
  elsif colour_option
    for v in colour_option.values
      assign v_img = ''
      for var in product.variants
        if var[opt_colour_key] == v and var.featured_media and v_img == ''
          assign v_img = var.featured_media | image_url: width: 300
        endif
      endfor
      if v_img != ''
        assign img_swatches = true
      endif
      assign sw_names = sw_names | append: v | append: '~~'
      assign sw_urls = sw_urls | append: '#~~'
      assign sw_imgs = sw_imgs | append: v_img | append: '~~'
      if v == current_colour
        assign sw_active = sw_active | append: '1~~'
      else
        assign sw_active = sw_active | append: '0~~'
      endif
    endfor
  endif
  assign names_a = sw_names | split: '~~'
  assign urls_a = sw_urls | split: '~~'
  assign act_a = sw_active | split: '~~'
  assign imgs_a = sw_imgs | split: '~~'
  # If any swatch is missing an image, fall back to colour circles for consistency
  if img_swatches
    for nm in names_a
      assign chk_img = imgs_a[forloop.index0]
      if chk_img == blank
        assign img_swatches = false
        break
      endif
    endfor
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@200;300;400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet"/>

<style>
.sft-section {
  --ink: #0a0a0a;
  --forest: #2A3B27;
  --cream: #F6F4F0;
  --paper: #F2ECE4;
  --sage: #E8EDE4;
  --moss: #A8BE98;
  --moss-dk: #6B7D5E;
  --text: #1a1a1a;
  --text-b: #2a2a2a;
  --text-m: #6b6b6b;
  --line: #e4e1dc;
  --line-d: #eeeeee;
  --amber: #B07D3A;
  --gold: #C9A227;
  --red: #7A3030;
  --pill: 40px;
  --ease: cubic-bezier(0.22,1,0.36,1);
  --spring: cubic-bezier(0.34,1.56,0.64,1);
  font-family: 'Jost', Helvetica, Arial, sans-serif;
  color: var(--text);
  background: #fff;
}
.sft-section *, .sft-panel *, .sft-overlay * { box-sizing: border-box; }

/* ===== HERO GALLERY — full-width image ===== */
.sft-hero { background: #f6f6f5; width: 100%; }
.sft-gallery__main {
  width: 100%; aspect-ratio: 3/4; overflow: hidden; position: relative;
  background: #f0efed;
}
.sft-gallery__main img { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.32s ease; display: block; }
.sft-gallery__main img.fading { opacity: 0; }

/* Thumbs (desktop only — shown under hero) */
.sft-thumbs { display: flex; gap: 6px; padding: 6px 0 0; }
.sft-thumb {
  flex: 0 0 auto; width: 72px; aspect-ratio: 3/4; overflow: hidden; cursor: pointer;
  border: 1.5px solid transparent; opacity: 0.45;
  transition: opacity 0.2s, border-color 0.2s; background: #f0efed;
}
.sft-thumb img { width: 100%; height: 100%; object-fit: cover; }
.sft-thumb.active, .sft-thumb:hover { opacity: 1; border-color: var(--ink); }

/* Dot indicators (mobile only) */
.sft-dots { display: none; justify-content: center; gap: 6px; padding: 14px 0 4px; }
.sft-dot {
  height: 4px; background: rgba(0,0,0,0.18); border-radius: 2px;
  transition: background 0.2s, width 0.25s var(--ease); cursor: pointer;
  width: 20px; border: none; padding: 0;
}
.sft-dot.active { background: var(--ink); width: 36px; }

/* ===== DESKTOP LAYOUT ===== */
@media (min-width: 861px) {
  .sft-hero { }
  .sft-gallery__main { aspect-ratio: 3/4; max-height: 95vh; }
  .sft-thumbs-wrap { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .sft-dots { display: none !important; }
  .sft-thumbs { display: flex; }
}

/* ===== PRODUCT DETAILS ===== */
.sft-product-row { background: #fff; }
.sft-details { padding: 52px 24px 80px; max-width: 700px; margin: 0 auto; }

.sft-eyebrow {
  font-size: 10px; font-weight: 500; letter-spacing: 0.28em;
  text-transform: uppercase; color: var(--moss-dk); margin-bottom: 16px;
  font-family: 'Jost', sans-serif;
}
.sft-title {
  font-family: 'Raleway', Georgia, sans-serif;
  font-size: 44px; font-weight: 300; line-height: 1.05;
  letter-spacing: -0.01em; color: var(--ink); margin: 0 0 10px;
}
.sft-title em { font-style: italic; font-weight: 200; }
.sft-price { font-size: 16px; font-weight: 300; color: var(--text-b); margin-bottom: 28px; letter-spacing: 0.04em; }
.sft-rule { width: 38px; height: 1px; background: var(--ink); margin-bottom: 28px; opacity: 0.15; }
.sft-desc { font-size: 14px; font-weight: 300; line-height: 1.85; color: var(--text-m); margin-bottom: 34px; }

.sft-pick-label {
  font-size: 10px; font-weight: 500; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--text-m);
  display: flex; align-items: center; gap: 10px; margin-bottom: 14px;
}
.sft-pick-val { font-size: 12px; font-weight: 400; color: var(--text); text-transform: none; letter-spacing: 0.04em; }
.sft-swatches { display: flex; gap: 12px; margin-bottom: 34px; flex-wrap: wrap; }
.sft-swatch {
  width: 32px; height: 32px; border-radius: 50%; cursor: pointer; display: block;
  border: 2px solid transparent; position: relative; padding: 0;
  transition: transform 0.2s var(--spring); box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06);
}
.sft-swatch::after {
  content: ''; position: absolute; inset: -4px; border-radius: 50%;
  border: 1.5px solid transparent; transition: border-color 0.2s;
}
.sft-swatch.active::after { border-color: var(--ink); }
.sft-swatch:hover { transform: scale(1.12); }

/* Rating */
.sft-rating { display: flex; align-items: center; gap: 9px; margin-bottom: 22px; }
.sft-stars { color: var(--gold); font-size: 14px; letter-spacing: 2px; }
.sft-rating-ct { font-size: 12px; font-weight: 300; color: var(--text-m); }

/* Section header rows */
.sft-row-hd { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12px; }
.sft-row-hd--col { margin-top: 30px; }
.sft-row-lbl { font-size: 10px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-b); font-family: 'Jost', sans-serif; }
.sft-link { font-size: 10px; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-m); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; background: none; border: none; font-family: inherit; padding: 0; }
.sft-link:hover { color: var(--ink); }
.sft-returns-note { text-align: center; font-size: 10px; font-weight: 400; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-m); margin: 6px 0 2px; }

/* Image swatches */
.sft-iswatches { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 8px; -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
.sft-iswatch { flex: 0 0 auto; width: 84px; cursor: pointer; text-decoration: none; background: none; border: none; padding: 0; font-family: inherit; }
.sft-iswatch__imgwrap { position: relative; display: block; }
.sft-iswatch__img { width: 84px; height: 100px; object-fit: cover; background: #f0efed; border: 1.5px solid var(--line); transition: border-color 0.2s; display: block; }
.sft-iswatch:hover .sft-iswatch__img { border-color: var(--text-m); }
.sft-iswatch.active .sft-iswatch__img { border-color: var(--ink); }
.sft-iswatch__check { position: absolute; top: 7px; right: 7px; width: 20px; height: 20px; border-radius: 50%; background: var(--ink); display: none; align-items: center; justify-content: center; }
.sft-iswatch.active .sft-iswatch__check { display: flex; }
.sft-iswatch__check svg { width: 11px; height: 11px; stroke: #fff; stroke-width: 2.6; fill: none; stroke-linecap: round; stroke-linejoin: round; }
.sft-iswatch__nm { display: block; text-align: center; margin-top: 7px; font-size: 9px; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-m); }
.sft-iswatch.active .sft-iswatch__nm { color: var(--ink); font-weight: 500; }

/* Tabs */
.sft-tabs { margin-top: 38px; border-top: 1px solid var(--line); }
.sft-tabs__nav { display: flex; }
.sft-tab { flex: 1; padding: 16px 6px; background: none; border: none; border-bottom: 1.5px solid transparent; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 10px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-m); transition: color 0.2s, border-color 0.2s; }
.sft-tab.active { color: var(--ink); border-bottom-color: var(--ink); }
.sft-tab:hover { color: var(--ink); }
.sft-tabpanel { display: none; padding: 22px 2px 0; font-size: 13px; font-weight: 300; line-height: 1.88; color: var(--text-m); }
.sft-tabpanel.active { display: block; }
.sft-tabpanel ul { padding-left: 16px; margin: 0; }
.sft-tabpanel li { margin-bottom: 5px; }

/* SELECT SIZE button — BLACK */
.sft-sz-btn {
  width: 100%; padding: 18px 24px; background: #000; color: #fff;
  font-family: 'Jost', Helvetica, Arial, sans-serif;
  font-size: 11px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase;
  border-radius: 2px; border: none; display: flex; align-items: center;
  justify-content: space-between; cursor: pointer; transition: background 0.18s, transform 0.15s; margin-bottom: 14px;
}
.sft-sz-btn:hover { background: #222; }
.sft-sz-btn:active { transform: scale(0.99); }
.sft-sz-btn__l { display: flex; align-items: center; gap: 11px; }
.sft-sz-btn__l svg { width: 16px; height: 16px; stroke: rgba(255,255,255,0.7); fill: none; stroke-width: 1.5; stroke-linecap: round; }
.sft-sz-btn__r svg { width: 13px; height: 13px; stroke: rgba(255,255,255,0.7); fill: none; stroke-width: 2; stroke-linecap: round; }

/* ===== SLIDE-OUT SIZE PANEL — WHITE ===== */
.sft-overlay {
  position: fixed; inset: 0; background: rgba(10,10,10,0.38);
  opacity: 0; visibility: hidden; transition: opacity 0.4s var(--ease), visibility 0.4s; z-index: 99998;
  -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
}
.sft-overlay.open { opacity: 1; visibility: visible; }
.sft-panel {
  position: fixed; top: 0; right: 0; height: 100%; width: 480px; max-width: 94vw;
  background: #ffffff; transform: translateX(100%); transition: transform 0.5s var(--ease);
  z-index: 99999; display: flex; flex-direction: column;
  font-family: 'Jost', Helvetica, Arial, sans-serif; color: var(--text);
  box-shadow: -24px 0 80px rgba(0,0,0,0.14);
}
.sft-panel.open { transform: translateX(0); }

/* Prominent X close button */
.sft-panel__top {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 24px 0;
}
.sft-panel__top-lbl { font-size: 10px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-m); }
.sft-panel__close {
  width: 44px; height: 44px; background: #f0f0f0; border-radius: 50%;
  border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: background 0.18s, transform 0.15s; flex-shrink: 0;
}
.sft-panel__close:hover { background: #e0e0e0; transform: scale(1.06); }
.sft-panel__close svg { width: 16px; height: 16px; stroke: var(--ink); fill: none; stroke-width: 2.2; stroke-linecap: round; }

.sft-panel__prod { display: flex; align-items: center; gap: 16px; padding: 16px 28px 20px; border-bottom: 1px solid var(--line); }
.sft-panel__thumb { width: 58px; height: 72px; object-fit: cover; background: #f0efed; flex-shrink: 0; }
.sft-panel__pt { font-family: 'Raleway', sans-serif; font-size: 20px; font-weight: 300; line-height: 1.15; margin: 0 0 4px; color: var(--ink); }
.sft-panel__pp { font-size: 13px; font-weight: 300; color: var(--text-m); }

.sft-panel__hd {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 28px; border-bottom: 1px solid var(--line); background: #fff;
}
.sft-panel__hl { font-size: 10px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-b); }
.sft-panel__hg { font-size: 10px; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-m); background: none; border: none; cursor: pointer; font-family: inherit; display: flex; align-items: center; gap: 6px; text-decoration: underline; text-underline-offset: 3px; }
.sft-panel__hg svg { width: 12px; height: 12px; stroke: var(--text-m); fill: none; stroke-width: 1.6; }

.sft-panel__list { flex: 1; overflow-y: auto; background: #fff; }
.sft-prow {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 28px; border-bottom: 1px solid var(--line-d); cursor: pointer;
  transition: background 0.15s; position: relative; background: #fff;
}
.sft-prow:hover { background: #f8f8f8; }
.sft-prow.selected { background: #f5f5f5; }
.sft-prow.selected::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--ink); }
.sft-prow.disabled { cursor: default; }
.sft-prow.disabled:hover { background: #fff; }
.sft-prow__nm { font-size: 13px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text); }
.sft-prow.disabled .sft-prow__nm { color: #C0BDB9; }
.sft-prow__st { font-size: 10px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; }
.sft-prow__st.in { color: var(--moss-dk); }
.sft-prow__st.low { color: var(--amber); }
.sft-prow__st.notify { color: var(--text-m); text-decoration: underline; text-underline-offset: 3px; }
.sft-notify-wrap { overflow: hidden; max-height: 0; opacity: 0; transition: max-height 0.32s var(--ease), opacity 0.25s; background: #f9f9f9; }
.sft-notify-wrap.open { max-height: 110px; opacity: 1; }
.sft-notify-inner { padding: 14px 28px 18px; }
.sft-notify-cap { font-size: 11px; font-weight: 300; color: var(--text-m); margin-bottom: 9px; }
.sft-notify-row { display: flex; gap: 7px; }
.sft-notify-input { flex: 1; padding: 11px 15px; font-family: inherit; font-size: 12px; font-weight: 300; color: var(--text); background: #fff; border: 1px solid var(--line); border-radius: 2px; outline: none; }
.sft-notify-input:focus { border-color: var(--ink); }
.sft-notify-sub { padding: 11px 18px; font-family: inherit; font-size: 9px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; background: var(--ink); color: #fff; border-radius: 2px; border: none; cursor: pointer; white-space: nowrap; }
.sft-notify-sub:hover { background: #333; }
.sft-notify-sub.sent { background: #e8f4e8; color: var(--forest); }

.sft-panel__foot { padding: 18px 28px 28px; border-top: 1px solid var(--line); background: #fff; }
.sft-panel__sel { font-size: 11px; font-weight: 300; letter-spacing: 0.04em; color: var(--text-m); margin-bottom: 12px; min-height: 15px; text-align: center; }
.sft-panel__sel b { color: var(--text); font-weight: 500; }
.sft-addbag {
  width: 100%; padding: 18px; background: var(--ink); color: #fff;
  font-family: 'Jost', sans-serif; font-size: 11px; font-weight: 500; letter-spacing: 0.22em;
  text-transform: uppercase; border: none; border-radius: 2px; cursor: pointer;
  transition: background 0.18s, opacity 0.2s, transform 0.15s;
}
.sft-addbag:hover:not(:disabled) { background: #333; }
.sft-addbag:active:not(:disabled) { transform: scale(0.99); }
.sft-addbag:disabled { background: #d0d0d0; color: #999; cursor: not-allowed; }
.sft-addbag.added { background: #e8f4e8; color: var(--forest); }

/* ===== FEATURE BAR ===== */
.sft-feat { background: var(--ink); color: #EDEAE3; }
.sft-feat__in { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(3,1fr); }
.sft-feat__col { padding: 48px 52px; border-left: 1px solid rgba(255,255,255,0.08); }
.sft-feat__col:first-child { border-left: none; }
.sft-feat__t { font-family: 'Raleway', sans-serif; font-size: 28px; font-weight: 300; margin: 0 0 12px; color: #fff; letter-spacing: -0.01em; }
.sft-feat__x { font-size: 14px; font-weight: 300; line-height: 1.65; color: #9A9690; margin: 0; }

/* ===== EDITORIAL ===== */
.sft-ed { background: #fff; padding: 100px 24px; border-top: 1px solid var(--line); }
.sft-ed__in { max-width: 1280px; margin: 0 auto; }
.sft-ed__h { font-family: 'Raleway', sans-serif; font-size: 56px; font-weight: 300; line-height: 1.04; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 22px; }
.sft-ed__b { font-size: 16px; font-weight: 300; line-height: 1.75; color: var(--text-m); max-width: 620px; margin: 0 0 60px; }
.sft-cards { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
.sft-card { background: #fff; padding: 36px 32px; }
.sft-card__t { font-family: 'Raleway', sans-serif; font-size: 22px; font-weight: 300; line-height: 1.15; color: var(--ink); margin: 0 0 12px; }
.sft-card__x { font-size: 13px; font-weight: 300; line-height: 1.75; color: var(--text-m); margin: 0; }

/* ===== REVIEWS — Klaviyo widget ===== */
.sft-rev { background: var(--ink); padding: 96px 24px; }
.sft-rev__in { max-width: 1280px; margin: 0 auto; }
.sft-rev__h { font-family: 'Raleway', sans-serif; font-size: 50px; font-weight: 300; line-height: 1.05; color: #fff; margin: 0 0 48px; letter-spacing: -0.01em; }
.sft-rev__widget { }
/* Klaviyo renders its own stars/cards — let it take over */
.sft-rev .klaviyo-product-reviews { color: #fff; }

/* ===== FINAL CTA ===== */
.sft-cta { background: #fff; padding: 110px 24px; text-align: center; border-top: 1px solid var(--line); }
.sft-cta__h { font-family: 'Raleway', sans-serif; font-size: 58px; font-weight: 300; line-height: 1.02; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 18px; }
.sft-cta__x { font-size: 16px; font-weight: 300; color: var(--text-m); margin: 0 0 40px; }
.sft-cta__btn {
  display: inline-block; padding: 19px 58px; background: var(--ink); color: #fff;
  font-family: 'Jost', sans-serif; font-size: 11px; font-weight: 500; letter-spacing: 0.22em;
  text-transform: uppercase; border: none; border-radius: 2px; cursor: pointer; transition: background 0.2s, transform 0.15s;
}
.sft-cta__btn:hover { background: #333; }
.sft-cta__btn:active { transform: scale(0.99); }

/* ===== TOAST ===== */
.sft-toast {
  position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%) translateY(20px); opacity: 0;
  background: var(--ink); color: #fff; font-size: 11px; font-weight: 500; letter-spacing: 0.12em;
  text-transform: uppercase; padding: 14px 28px; border-radius: 2px; z-index: 999999; pointer-events: none;
  transition: transform 0.4s var(--spring), opacity 0.3s ease; white-space: nowrap;
}
.sft-toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

/* ===== RESPONSIVE ===== */
@media (max-width: 980px) {
  .sft-cards { grid-template-columns: repeat(2,1fr); }
  .sft-feat__in { grid-template-columns: 1fr; }
  .sft-feat__col { border-left: none; border-top: 1px solid rgba(255,255,255,0.08); }
  .sft-feat__col:first-child { border-top: none; }
}
@media (max-width: 860px) {
  /* Mobile: hide thumbs, show dots */
  .sft-thumbs { display: none !important; }
  .sft-dots { display: flex; }
  /* Full-bleed portrait image */
  .sft-gallery__main { aspect-ratio: 3/4; }
  .sft-details { padding: 28px 18px 64px; }
  .sft-title { font-size: 34px; }
  .sft-ed { padding: 64px 18px; }
  .sft-ed__h { font-size: 38px; }
  .sft-rev { padding: 64px 18px; }
  .sft-rev__h { font-size: 34px; }
  .sft-cta { padding: 76px 18px; }
  .sft-cta__h { font-size: 38px; }
}
@media (max-width: 560px) {
  .sft-cards { grid-template-columns: 1fr; }
  .sft-title { font-size: 30px; }
  .sft-ed__h { font-size: 32px; }
}
</style>

<div class="sft-section">

  <!-- ===== FULL-WIDTH GALLERY ===== -->
